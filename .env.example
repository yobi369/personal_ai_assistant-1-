# Copy to .env for local development. Never commit real secrets.
DATA_DIR=./data
DATABASE_PATH=./data/assistant.sqlite3
# Optional: set DATABASE_URL=postgresql://... to use PostgreSQL instead of SQLite.
DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:8000
ALLOW_REGISTRATION=true
COOKIE_SECURE=false
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
# Only for explicitly trusted local testing; never enable in production:
ALLOW_INSECURE_MODEL_URL=false
